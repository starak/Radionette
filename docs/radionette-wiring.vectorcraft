                  1.0,
                  1825.0,
                  876.0
                ],
                "runs": [
                  {
                    "text": "• Power the Pi off before changing display wiring.\n• Both variants use the same SPI, DC and reset signals.\n• GPIO 13 is active HIGH: on while HIGH, off while LOW.\n• Software auto-off is 20 seconds after the last visible event.",
                    "style": {
                      "font_family": "Inter",
                      "font_style": "Regular",
                      "size": 15.0,
                      "tracking": 0.0,
                      "baseline_shift": 0.0,
                      "h_scale": 100.0,
                      "v_scale": 100.0,
                      "rotation": 0.0,
                      "fill": {
                        "type": "solid",
                        "color": {
                          "model": "rgb",
                          "r": 0.2,
                          "g": 0.25490198,
                          "b": 0.33333334
                        }
                      },
                      "stroke": {
                        "type": "none"
                      },
                      "stroke_width": 0.0,
                      "underline": false,
                      "strikethrough": false,
                      "all_caps": false
                    }
                  }
                ],
                "para": {
                  "justify": "Left",
                  "justify_auto": true,
                  "left_indent": 0.0,
                  "right_indent": 0.0,
                  "first_line_indent": 0.0,
                  "space_before": 0.0,
                  "space_after": 0.0,
                  "hyphenate": false,
